            "later"
          ]
        },
        "priority": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "waiting",
            "blocked"
          ]
