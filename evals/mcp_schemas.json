{
  "todo.todo_list": {
    "server": "todo",
    "name": "todo_list",
    "description": "List todo items with optional filters",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "Filter by project"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "waiting",
            "blocked"
          ],
          "description": "Filter by status"
        },
        "lane": {
          "type": "string",
          "enum": [
            "now",
            "today",
            "later"
          ],
          "description": "Filter by lane"
        },
        "limit": {
          "type": "integer",
          "default": 50,
          "description": "Max results"
        }
      }
    }
  },
  "todo.todo_add": {
    "server": "todo",
    "name": "todo_add",
    "description": "Add a new todo item",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Task title"
        },
        "project": {
          "type": "string",
          "default": "default",
          "description": "Project name"
        },
        "lane": {
          "type": "string",
          "enum": [
            "now",
            "today",
            "later"
          ],
          "default": "today"
        },
        "priority": {
          "type": "integer",
          "enum": [
            1,
            2,
            3,
            4
          ],
          "description": "Priority 1-4"
        },
        "estimate": {
          "type": "integer",
          "description": "Estimated minutes"
        },
        "due": {
          "type": "string",
          "description": "ISO8601 due date"
        }
      },
      "required": [
        "title"
      ]
    }
  },
  "todo.todo_done": {
    "server": "todo",
