  "browser_search.search_and_store": {
    "server": "browser_search",
    "name": "search_and_store",
    "description": "Run web search, store results with 768-dim embeddings in Supabase/PostgreSQL",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query to execute and store"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "description": "Max search results to fetch and store"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search sources (searxng, google, web)"
        },
        "metadata": {
          "type": "object",
          "description": "Optional search metadata"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  "browser_search.search_semantic": {
    "server": "browser_search",
    "name": "search_semantic",
    "description": "Semantic search across stored searches using Supabase pgvector",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query text to compute embedding for and match"
        },
        "query_embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Optional precomputed 768-dim query vector"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "description": "Max results to return"
        },
        "threshold": {
          "type": "number",
          "default": 0.5,
          "description": "Cosine similarity threshold (0.0 to 1.0)"
        }
      }
    }
  },
  "browser_search.summarize_results": {
    "server": "browser_search",
    "name": "summarize_results",
    "description": "Summarize search results using LangChain summarization chain",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Original search query"
        },
        "result_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Result or search IDs to summarize"
        }
      },
      "required": [
        "query",
        "result_ids"
      ]
    }
  },
  "browser_search.expand_query": {
    "server": "browser_search",
    "name": "expand_query",
    "description": "Expand query using LangChain query expansion chain",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Original query to expand"
        },
        "num_variations": {
          "type": "integer",
          "default": 5,
          "description": "Number of query variations to generate"
        }
      },
      "required": [
        "query"
      ]
    }
  },
  "postgres.sql": {
    "server": "postgres",
    "name": "sql",
    "description": "Execute arbitrary SQL query on the database",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "SQL query to execute"
        },
        "params": {
          "type": "array",
          "description": "Query parameters",
          "items": {}
        }
      },
      "required": [
        "query"
      ]
    }
  },
  "postgres.vector_search": {
    "server": "postgres",
    "name": "vector_search",
    "description": "Search for similar vectors using pgvector",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query_embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Query vector"
        },
        "table": {
          "type": "string",
          "default": "documents",
          "description": "Table to search"
        },
        "limit": {
          "type": "integer",
          "default": 10,
          "description": "Max results"
        },
        "threshold": {
          "type": "number",
          "default": 0.0,
          "description": "Similarity threshold"
        },
        "probes": {
          "type": "integer",
          "default": 10,
          "description": "IVFFlat probes (1-50)",
          "maximum": 50,
          "minimum": 1
        },
        "ef_search": {
          "type": "integer",
          "default": 40,
          "description": "HNSW ef_search (1-200)",
          "maximum": 200,
          "minimum": 1
        }
      },
      "required": [
        "query_embedding"
      ]
    }
  },
